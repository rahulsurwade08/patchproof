{
  "_readme": [
    "PatchProof harness configuration DRAFT.",
    "Field names must be verified against TrueForge docs (trueforge.dev) on",
    "first run of `npx @truefoundry/trueforge`; adjust rather than trust this",
    "shape. Model id comes from OPENROUTER_MODEL; key from OPENROUTER_API_KEY.",
    "Free-model shortlist to test: deepseek/deepseek-chat-v3.1:free,",
    "qwen/qwen3-coder:free, meta-llama/llama-3.3-70b-instruct:free"
  ],
  "model": {
    "provider": "openai-compatible",
    "baseUrl": "https://openrouter.ai/api/v1",
    "apiKeyEnv": "OPENROUTER_API_KEY",
    "modelIdEnv": "OPENROUTER_MODEL"
  },
  "mcpServers": {
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_TOKEN": "{env:GITHUB_TOKEN}" }
    },
    "nvd": {
      "type": "local",
      "command": ["node", "agent/mcp/nvd-server/index.mjs"],
      "env": { "NVD_API_KEY": "{env:NVD_API_KEY}" }
    }
  }
}
