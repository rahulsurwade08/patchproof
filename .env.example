# Copy to .env and fill in. Never commit .env.

# Reference for the credentials TrueForge needs. TrueForge itself is configured
# via its Settings UI/API (see docs/trueforge-setup.md) — values here are what
# you'll paste there, plus vars used by repo scripts.

# OpenRouter key (https://openrouter.ai/settings/keys) — Settings → Models
OPENROUTER_API_KEY=
# Free model id on OpenRouter, e.g. deepseek/deepseek-chat-v3.1:free
OPENROUTER_MODEL=

# GitHub credential — preferred: no static token at all. In TrueForge Settings
# → Connectors → GitHub, choose the OAuth flow and authorize in the browser.
# Alternative for API-only use: create a classic PAT at
# github.com/settings/tokens (repo scope), paste it below AND into the
# connector's header-auth field in TrueForge Settings (.env alone configures
# nothing). Never print tokens to the terminal or share them.
GITHUB_TOKEN=

# Daytona sandbox provider — the only sandbox TrueForge supports; Settings → Sandbox providers
DAYTONA_API_KEY=
# Optional: override the Daytona API endpoint (e.g. for self-hosted instances)
# DAYTONA_BASE_URL=

# Where the orchestrator picks up injected advisories
PATCHPROOF_INBOX=data/inbox
