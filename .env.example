# Copy to .env and fill in. Never commit .env.

# OpenRouter key (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=
# Free model id on OpenRouter, e.g. deepseek/deepseek-chat-v3.1:free
OPENROUTER_MODEL=

# GitHub personal access token used by the github MCP server (repo scope)
GITHUB_TOKEN=

# Optional: raises NVD API rate limits (https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=

# Daytona sandbox provider — the only sandbox TrueForge supports (https://daytona.io)
DAYTONA_API_KEY=

# Where the orchestrator picks up injected advisories
PATCHPROOF_INBOX=data/inbox
