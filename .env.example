# Copy to .env and fill in. Never commit .env.

# The Python scripts (orchestrate.py, build_image.py) don't load this file.
# These vars configure the OpenCode harness and MCP servers.

# Optional: skip the image build step.
# Without this, orchestrate.py builds the image from scratch.
PATCHPROOF_IMAGE=

# Optional: override default MCP server ports.
# LOCAL_SANDBOX_PORT=8081
# CVE_FEED_PORT=8091

# OpenCode / LLM vars — set by your harness, not by PatchProof Python code.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# GITHUB_TOKEN=
