# Copy to .env and fill in. Never commit .env.

# OpenRouter key (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=
# Free model id on OpenRouter, e.g. deepseek/deepseek-chat-v3.1:free
OPENROUTER_MODEL=

# GitHub credential — write the stored credential value from `gh` directly into
# this file yourself, outside any agent session. Needs repo scope.
# Never print tokens to the terminal or share them.
GITHUB_TOKEN=

# NOTE: no cloud-sandbox keys needed — PatchProof uses its own local
# Docker sandbox via the local-sandbox MCP server.

# Where the orchestrator picks up injected advisories
PATCHPROOF_INBOX=data/inbox
