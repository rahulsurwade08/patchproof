# Copy to .env and fill in. Never commit .env.

# Reference for the credentials TrueForge needs. TrueForge itself is configured
# via its Settings UI/API (see docs/trueforge-setup.md) — values here are what
# you'll paste there, plus vars used by repo scripts.

# OpenRouter key (https://openrouter.ai/settings/keys) — Settings → Models
OPENROUTER_API_KEY=
# Free model id on OpenRouter, e.g. deepseek/deepseek-chat-v3.1:free
OPENROUTER_MODEL=

# GitHub credential — preferred: derive from your existing gh CLI login WITHOUT
# displaying it (run once yourself, outside any agent session):
#   { printf 'GITHUB_TOKEN='; gh auth token; } >> .env
# Then paste the same value into TrueForge Settings → Connectors → GitHub
# header auth (.env alone configures nothing). Needs repo scope.
# Never print tokens to the terminal or share them.
GITHUB_TOKEN=

# NOTE: no Daytona/cloud-sandbox keys needed — PatchProof uses its own local
# Docker sandbox (see docs/trueforge-setup.md §4).

# Where the orchestrator picks up injected advisories
PATCHPROOF_INBOX=data/inbox
